Example routing code
app.post("/generate-home", async (req, res) => {
    const { budget, category, room } = req.body;

    let recommendations = [];

    if (category === "furniture") {
        recommendations = await getFurniture(budget, room);
    } 
    else if (category === "decor") {
        recommendations = await getDecor(budget, room);
    } 
    else if (category === "lighting") {
        recommendations = await getLighting(budget, room);
    }

    res.json({
        type: "home",
        budget,
        recommendations
    });
});

app.post("/generate-party", async (req, res) => {
    const { budget, eventType, guests } = req.body;

    let recommendations = [];

    if (eventType === "birthday") {
        recommendations = await getBirthdayRecommendations(
            budget,
            guests
        );
    } 
    else if (eventType === "wedding") {
        recommendations = await getWeddingRecommendations(
            budget,
            guests
        );
    }

    res.json({
        type: "party",
        budget,
        recommendations
    });
});
